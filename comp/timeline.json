 "telops": [],
 "vo": [
  {
   "id": "N1",
   "src": "assets/audio/vo/N1.wav",
   "start": 1.0344,
   "dur": 4.18,
   "text": "測量部門の仕事のひとつ、基準点測量です。"
  },
  {
   "id": "N2",
   "src": "assets/audio/vo/N2.wav",
   "start": 7.9746,
   "dur": 6.61,
   "text": "地図や道路の図面をつくるには、まず、位置が正確にわかる“目印”が必要です。"
  },
  {
   "id": "N3",
   "src": "assets/audio/vo/N3.wav",
   "start": 16.383,
   "dur": 2.9,
   "text": "その目印を、「基準点」といいます。"
  },
  {
   "id": "N4",
   "src": "assets/audio/vo/N4.wav",
   "start": 21.6883,
   "dur": 4.86,
   "text": "この機械で、向こうのプリズムまでの、角度と距離をはかります。"
  },
  {
   "id": "N5a",
   "src": "assets/audio/vo/N5a.wav",
   "start": 27.2272,
   "dur": 3.55,
   "text": "位置がわかっている点からの、角度と距離で、"
  },
  {
   "id": "N5b",
   "src": "assets/audio/vo/N5b.wav",
   "start": 31.031,
   "dur": 2.78,
   "text": "新しい点の位置が、決まります。"
  },
  {
   "id": "N6",
   "src": "assets/audio/vo/N6.wav",
   "start": 35.8358,
   "dur": 5.71,
   "text": "何度もはかり、ほかの目印ともつないで、ずれがないかを確かめます。"
  },
  {
   "id": "N7a",
   "src": "assets/audio/vo/N7a.wav",
   "start": 43.3099,
   "dur": 2.0,
   "text": "こうしてできた点を手がかりに、"
  },
  {
   "id": "N7b",
   "src": "assets/audio/vo/N7b.wav",
   "start": 45.6122,
   "dur": 4.1,
   "text": "地図や、道路の図面が、描かれていきます。"
  },
  {
   "id": "N8",
   "src": "assets/audio/vo/N8.wav",
   "start": 51.4514,
   "dur": 7.49,
   "text": "ほかの測量が使う、“はじまりの点”をつくる。それが、基準点測量です。"
  }
 ],
